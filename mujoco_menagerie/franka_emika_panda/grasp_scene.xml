<!--
Based on google-deepmind/mujoco_menagerie/franka_emika_panda/scene.xml
Source: https://github.com/google-deepmind/mujoco_menagerie/tree/main/franka_emika_panda
License: Apache-2.0
This local file adds a table, a graspable cube, and scene settings for a
Franka Panda grasp experiment.
-->
<mujoco model="panda grasp scene">
  <include file="panda.xml"/>

  <statistic center="0.45 0 0.35" extent="1.2"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.43 0.32 1"/>
    <material name="cube_mat" rgba="0.95 0.1 0.1 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.8" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <body name="world_axes" pos="0 0 0">
      <site name="world_origin" type="sphere" pos="0 0 0.008" size="0.008" rgba="1 1 1 1"/>
      <site name="world_x_axis" type="capsule" fromto="0 0 0.008 1 0 0.008" size="0.006" rgba="0.95 0.20 0.20 1"/>
      <site name="world_y_axis" type="capsule" fromto="0 0 0.008 0 1 0.008" size="0.006" rgba="0.20 0.85 0.20 1"/>
      <site name="world_z_axis" type="capsule" fromto="0 0 0.008 0 0 1" size="0.006" rgba="0.20 0.40 0.95 1"/>
    </body>

    <body name="cube" pos="0.62 0.18 0.03">
      <freejoint name="cube_freejoint"/>
      <geom name="cube_geom" type="box" size="0.03 0.03 0.03" mass="0.08" material="cube_mat"
        condim="3" friction="1.2 0.03 0.003" solref="0.003 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
